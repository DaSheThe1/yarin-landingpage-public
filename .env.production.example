# Production runtime environment for the VPS.
# Copy to .env.production next to compose.yaml and fill in real values.
# NEVER commit .env.production (git-ignored via .env*).

# Used in metadata/canonical URLs. Code already defaults to this value,
# but set it explicitly to be safe. TODO: confirm the real domain.
NEXT_PUBLIC_SITE_URL=https://yarin-avraham.co.il

# The real n8n webhook the /api/contact route forwards lead submissions to.
# If unset, the lead form returns a 503 "temporarily unavailable".
N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/REPLACE_WITH_PROD_PATH

# Shared secret sent as the `x-webhook-secret` header to n8n, so a leaked
# webhook URL alone can't be spammed. Must match the value in the n8n Webhook
# node's Header Auth credential (header name: x-webhook-secret).
# Generate a fresh one for production (do NOT reuse the dev value):
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET

# Address shown in copy / used for notifications.
CONTACT_TO_EMAIL=yarinavraham96@gmail.com

# Umami analytics (privacy-friendly, cookieless, self-hosted). Both are PUBLIC
# (they ship to the browser) and OPTIONAL — leave them blank and no analytics
# loads. Fill them in after deploying the Umami stack (see docs/16-analytics.md
# and infra/analytics/). The script URL points at your nginx-proxied Umami;
# the website id is the UUID Umami shows after you add the site.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=REPLACE_WITH_UMAMI_WEBSITE_ID

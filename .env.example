# Local development environment. Copy to .env.local and fill in.
# TODO: confirm the real production domain with Yarin before launch.
NEXT_PUBLIC_SITE_URL=https://yarin.trickticmedia.com
N8N_WEBHOOK_URL=https://REPLACE_WITH_N8N_HOST/webhook/REPLACE_WITH_LEAD_WEBHOOK_PATH
CONTACT_TO_EMAIL=yarinavraham96@gmail.com

# Shared secret sent as the `x-webhook-secret` header to the n8n webhook so a
# leaked URL can't be spammed. Must match the n8n Webhook node's Header Auth
# credential. Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET

# Analytics. We run two trackers in parallel — GA4 (client dashboards) and Umami
# (cookieless cross-check). All are PUBLIC (they ship to the browser) and
# OPTIONAL: leave a tracker's var(s) blank and that tracker is a complete no-op.
# Production values are also set in the build env (deploy-pages.yml) so the live
# static export ships them. See docs/16-analytics.md.

# Google Analytics 4 measurement id, "G-XXXXXXXXXX" (GA4 Admin → Data Streams).
NEXT_PUBLIC_GA_ID=
# Umami: tracker script URL (e.g. https://analytics.example.com/script.js) and
# the website UUID Umami assigns when you add the site. BOTH required to load.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
